# Runtime configuration for kilo-gateway. Bun loads this file automatically.
# Copy to .env and edit. All values shown are the built-in defaults.

PORT=8080
HOST=127.0.0.1

# Admin token for the dashboard API and /v1 playground. Empty = open dashboard.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# 1 = require a gateway key (`kg_...`) or a real Kilo key on /v1.
REQUIRE_KEY=0

DATA_DIR=./data
RETENTION_DAYS=30

KILO_UPSTREAM=https://api.kilo.ai/api/gateway
CATALOG_TTL_MS=300000
UPSTREAM_TIMEOUT_MS=900000
MAX_BODY_BYTES=33554432

ACCESS_LOG=0
CORS_ORIGIN=*
