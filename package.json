{
  "name": "kilo-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kilo Gateway free models as an OpenAI/Anthropic-compatible endpoint, with managed keys, quotas, request analytics and a dashboard.",
  "scripts": {
    "start": "bun src/server.ts",
    "start:node": "node src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "build": "bun build --compile src/server.ts --outfile dist/kilo-gateway",
    "build:worker": "cd cfwork && npx wrangler deploy --dry-run --outdir ../.wbuild"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
